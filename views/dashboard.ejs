<div class="dashboard-wrapper" style="margin-top: 2rem; margin-bottom: 4rem;">
  <div class="container">
    
    <% if (user.role === 'student' && typeof applications !== 'undefined') { %>
      <% applications.forEach(app => { %>
        <% if (app.pendingPing) { %>
          <div id="ping-alert-<%= app._id %>" class="alert animate__animated animate__shakeX" style="background: #fff7ed; border-left: 5px solid #f97316; padding: 1.2rem; border-radius: 12px; margin-bottom: 2rem; box-shadow: 0 4px 6px rgba(0,0,0,0.05); display: flex; align-items: center; gap: 15px;">
            <div style="font-size: 1.5rem; background: #ffedd5; padding: 10px; border-radius: 50%;">⚠️</div>
            <div style="flex-grow: 1;">
              <h6 class="fw-bold mb-1" style="color: #9a3412;"><%= __('dashboard.reminderTitle') %></h6>
              <p class="mb-0 small" style="color: #c2410c;">
                <%= app.pingMessage || __('dashboard.reminderMessagePlaceholder') %>
                <br>
                <span style="font-size: 0.8rem; opacity: 0.8;"><%= __('dashboard.companyLabel') %> <strong><%= app.company ? app.company.name : 'N/A' %></strong></span>
              </p>
            </div>
            <form action="/applications/clear-ping/<%= app._id %>" method="POST">
              <button type="submit" class="btn-close shadow-none" aria-label="<%= __('dashboard.close') %>"></button>
            </form>
          </div>
        <% } %>
      <% }) %>
    <% } %>

    <header class="mb-5">
      <h1 class="fw-bold"><%= __('dashboard.greeting') %> <%= user.name %>! 👋</h1>
      <p class="text-muted">
        <%= __('dashboard.roleLabel') %> 
        <% 
          let badgeClass = 'bg-secondary';
          let roleName = __('dashboard.roleUser');
          if (user.role === 'company') { badgeClass = 'bg-primary'; roleName = __('dashboard.roleCompany'); }
          else if (user.role === 'professor') { badgeClass = 'bg-info text-dark'; roleName = __('dashboard.roleProfessor'); }
          else if (user.role === 'student') { badgeClass = 'bg-success'; roleName = __('dashboard.roleStudent'); }
        %>
        <span class="badge <%= badgeClass %>" style="padding: 8px 12px; border-radius: 8px; font-weight: 600;">
          <%= roleName %>
        </span>
      </p>
    </header>

    <div class="row g-4">
      <div class="col-md-6 col-lg-4">
        
        <div class="stat-card" style="padding: 2rem; border-radius: 15px; background: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); border: 1px solid #f1f5f9;">
          <h3 class="fw-bold mb-4"><%= __('dashboard.myProfile') %></h3>
          
          <div class="mb-3">
            <p class="mb-0 text-secondary small"><%= __('dashboard.myProfile') %>:</p>
            <p class="fw-medium text-dark"><%= user.email %></p>
          </div>

          <% if (user.school) { %>
            <div class="mb-3">
              <p class="mb-0 text-secondary small"><%= __('dashboard.schoolLabel') || 'Училиште:' %></p>
              <p class="fw-medium text-dark">🏫 <%= user.school %></p>
            </div>
          <% } %>

          <% if (user.phone) { %>
            <div class="mb-3">
              <p class="mb-0 text-secondary small"><%= __('dashboard.phoneLabel') || 'Телефон:' %></p>
              <p class="fw-medium text-dark"><%= user.phone %></p>
            </div>
          <% } %>

          <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 1.5rem;">
            <a href="/profile" class="text-primary text-decoration-none fw-bold small"><%= __('dashboard.editProfile') %></a>
            
            <a href="/applications/my-list" class="btn" style="text-decoration: none; text-align: center; background-color: #6366f1; padding: 12px; border-radius: 8px; color: white; font-weight: 600; transition: 0.3s;">
              📩 <%= user.role === 'company' ? __('dashboard.viewApplicationsCompany') : __('dashboard.myApplications') %>
            </a>
          </div>
        </div>

        <% if (user.role === 'student') { %>
          <% 
            // Check if any application has status 'прифатено' (accepted)
            const activeInternship = typeof applications !== 'undefined' ? applications.find(a => a.status === 'прифатено') : null;
          %>
          
          <% if (activeInternship) { %>
            <div class="stat-card mt-4" style="padding: 2rem; border-radius: 15px; background: #f0fdf4; border: 2px solid #10b981; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); text-align: center;">
              <h4 class="fw-bold text-success mb-3"><%= __('dashboard.activeInternshipTitle') %></h4>
              <p class="small text-muted mb-4"><%= __('dashboard.activeInternshipDesc') %> <strong><%= activeInternship.company ? activeInternship.company.name : __('dashboard.companyLabel') %></strong> <%= 'is ongoing.' %></p>              
              <a href="/internship-hub" onclick="clearAllPings()" class="btn btn-success w-100" style="border-radius: 10px; font-weight: 700; padding: 12px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2);">
                <%= __('dashboard.goToLogbookBtn') %>
              </a>
            </div>
          <% } %>
        <% } %>

        <% if (user.role === 'professor') { %>
          <div class="stat-card mt-4" style="padding: 2rem; border-radius: 15px; background: #eff6ff; border: 2px solid #3b82f6;">
            <h4 class="fw-bold text-primary mb-3"><%= __('dashboard.mentorPanelTitle') %></h4>
            <p class="small text-muted mb-4"><%= __('dashboard.mentorPanelDesc') %> <strong><%= user.school %></strong>.</p>
            <a href="/professor/dashboard" class="btn btn-primary w-100" style="border-radius: 10px; font-weight: 700; padding: 10px;">
              <%= __('dashboard.monitoringListBtn') %>
            </a>
          </div>
        <% } %>
      </div>

      <div class="col-md-6 col-lg-8">
        <div class="stat-card" style="padding: 2rem; border-radius: 15px; background: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); border: 1px solid #f1f5f9;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h3 class="fw-bold m-0">
              <%= user.role === 'company' ? __('dashboard.postedListings') : (user.role === 'professor' ? __('dashboard.systemListings') : __('dashboard.availableInternships')) %>
            </h3>
            <% if (user.role === 'company') { %>
              <a href="/listings/create" class="btn" style="text-decoration: none; padding: 8px 16px; font-size: 0.85rem; background-color: #6366f1; border-radius: 8px; color: white; font-weight: 600;"><%= __('dashboard.newListing') %></a>
            <% } %>
          </div>

          <% if (user.role !== 'company') { %>
            <form action="/dashboard" method="GET" class="mb-4" style="background: #f8fafc; padding: 1rem; border-radius: 12px; display: flex; gap: 10px; flex-wrap: wrap; border: 1px solid #f1f5f9;">
              <input 
                type="text" 
                name="search" 
                placeholder="<%= __('dashboard.searchPlaceholder') %>" 
                class="form-control form-control-sm shadow-none" 
                style="flex: 2; min-width: 150px; border-radius: 8px;"
                value="<%= typeof search !== 'undefined' ? search : '' %>"
              >
              <button type="submit" class="btn btn-sm" style="background-color: #6366f1; color: white; border-radius: 8px; padding: 5px 15px;"><%= __('dashboard.searchBtn') %></button>
              <% if (typeof search !== 'undefined' && search) { %>
                <a href="/dashboard" class="btn btn-sm btn-light" style="border-radius: 8px;"><%= __('dashboard.clearSearch') %></a>
              <% } %>
            </form>
          <% } %>

          <div class="listings-container">
            <% if (typeof listings !== 'undefined' && listings.length > 0) { %>
              <% listings.forEach(listing => { %>
                <div class="listing-item" style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.2rem; background: #fff; transition: 0.2s; position: relative;">
                  <div style="display: flex; justify-content: space-between; align-items: start;">
                    <div>
                        <h4 style="margin: 0; color: #1e293b; font-weight: 700;"><%= listing.title %></h4>
                        <p style="font-size: 0.85rem; font-weight: 600; margin: 0.4rem 0; color: #6366f1;">🏢 <%= listing.company ? listing.company.name : 'Непозната компанија' %></p>
                    </div>
                    <span style="font-size: 0.75rem; background: #f1f5f9; color: #475569; padding: 4px 12px; border-radius: 20px; font-weight: 600;">📍 <%= listing.location %></span>
                  </div>
                  
                  <div class="mt-3">
                    <a href="/listings/<%= listing._id %>" class="text-primary text-decoration-none fw-bold" style="font-size: 0.85rem;"><%= __('dashboard.detailsLink') %></a>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-center py-5" style="border: 2px dashed #e2e8f0; border-radius: 12px;">
                <p class="text-secondary mb-0"><%= __('dashboard.noListingsMessage') %></p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-5 border-top pt-4">
      <a href="/api/auth/logout" class="text-danger text-decoration-none small fw-bold">
        <i class="bi bi-box-arrow-left me-1"></i> <%= __('dashboard.logout') %>
      </a>
    </div>
  </div>
</div>

<script>
  async function clearAllPings() {
    try {
      await fetch('/applications/clear-all-pings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
    } catch (err) {
      console.error("Error clearing all pings:", err);
    }
  }
</script>
