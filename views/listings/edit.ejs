<div class="form-container-wide">
  <div class="auth-card form-container-wide">
    <h2 style="text-align: left; margin-bottom: 0.5rem">
      <%= __('listings-edit.editTitle') %>
    </h2>
    <p class="text-muted" style="margin-bottom: 2rem">
      <%= __('listings-edit.editSubtitle') %>
    </p>

    <form action="/listings/edit/<%= listing._id %>" method="POST">
      <div
        style="display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 1.5rem"
      >
        <div style="flex: 2; min-width: 250px">
          <div class="form-group">
            <label><%= __('listings-edit.labelTitle') %></label>
            <input
              type="text"
              name="title"
              class="form-control"
              value="<%= listing.title %>"
              required
            />
          </div>
        </div>

        <div style="flex: 1; min-width: 200px">
          <div class="form-group">
            <label><%= __('listings-edit.labelLocation') %></label>
            <input
              type="text"
              name="location"
              class="form-control"
              value="<%= listing.location %>"
              required
            />
          </div>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem">
        <label><%= __('listings-edit.labelRequirements') %></label>
        <small class="label-help"
          ><%= __('listings-edit.labelReqHelp') %></small
        >
        <input
          type="text"
          name="requirements"
          class="form-control"
          value="<%= listing.requirements.join(', ') %>"
        />
      </div>

      <div class="form-group" style="margin-bottom: 2rem">
        <label><%= __('listings-edit.labelDescription') %></label>
        <textarea name="description" class="form-control" rows="8" required>
<%= listing.description %></textarea
        >
      </div>

      <div style="display: flex; flex-direction: column; gap: 10px">
        <div style="display: flex; gap: 15px; align-items: center">
          <button
            type="submit"
            class="btn"
            style="width: auto; padding: 0.8rem 2.5rem"
          >
            <%= __('listings-edit.buttonSave') %>
          </button>
          <a
            href="/listings/<%= listing._id %>"
            class="btn-link"
            style="text-decoration: none; color: var(--secondary)"
          >
            <%= __('listings-edit.buttonCancel') %>
          </a>
        </div>
      </div>
    </form>
  </div>
</div>
