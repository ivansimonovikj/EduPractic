<div class="container" style="margin-top: 2rem; margin-bottom: 4rem; max-width: 900px;">

  <a href="/dashboard" class="btn-link" style="display: inline-block; margin-bottom: 1.5rem; text-decoration: none;">
    <%= __('listings-view.backToDashboard') %>
  </a>

  <div class="stat-card" style="padding: 2.5rem; border-top: 6px solid var(--primary);">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h1 style="font-size: 2.25rem; color: var(--dark); margin-bottom: 0.5rem;"><%= listing.title %></h1>
        <p style="font-size: 1.1rem; color: var(--primary); font-weight: 600;">
          🏢 <%= listing.company.name %>
        </p>
      </div>
      <span style="background: var(--light-bg); padding: 8px 16px; border-radius: 50px; font-weight: 600; font-size: 0.9rem;">
        📍 <%= listing.location %>
      </span>
    </div>

    <hr style="margin: 2rem 0; border: 0; border-top: 1px solid #e2e8f0;">

    <div class="row" style="display: flex; flex-wrap: wrap; gap: 2rem;">
      <div style="flex: 2; min-width: 300px;">
        <h3 style="margin-bottom: 1rem;"><%= __('listings-view.descriptionTitle') %></h3>
        <p style="white-space: pre-line; line-height: 1.8; color: var(--secondary);">
          <%= listing.description %>
        </p>
      </div>

      <div style="flex: 1; min-width: 250px; background: #f8fafc; padding: 1.5rem; border-radius: 12px; height: fit-content;">
        <h3 style="font-size: 1.1rem; margin-bottom: 1rem;"><%= __('listings-view.requiredSkills') %></h3>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 2rem;">
          <% listing.requirements.forEach(skill => { %>
            <span style="background: var(--white); border: 1px solid #cbd5e1; padding: 4px 12px; border-radius: 6px; font-size: 0.85rem;">
              <%= skill %>
            </span>
          <% }) %>
        </div>

        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;"><%= __('listings-view.publishedOn') %></h3>
        <p class="text-muted" style="margin-bottom: 1.5rem;">
          <%= new Date(listing.dateCreated).toLocaleDateString(lng === 'mk' ? 'mk-MK' : 'en-US') %>
        </p>

        <% if (user.role === 'student') { %>
          <div style="border-top: 1px solid #e2e8f0; padding-top: 1.5rem; margin-top: 1rem;">
            <h3 style="font-size: 1.1rem; margin-bottom: 1rem;"><%= __('listings-view.applyHere') %></h3>
            <form action="/applications/apply/<%= listing._id %>" method="POST">
              <div class="form-group" style="margin-bottom: 1rem;">
                <textarea 
                  name="message" 
                  class="form-control" 
                  rows="4" 
                  placeholder="<%= __('listings-view.applicationPlaceholder') %>" 
                  required
                  style="width: 100%; border-radius: 8px; padding: 10px; font-size: 0.9rem; border: 1px solid #cbd5e1; resize: none;"
                ></textarea>
              </div>
              <button type="submit" class="btn" style="width: 100%; text-align: center;">
                <%= __('listings-view.sendApplication') %>
              </button>
            </form>
          </div>
        <% } %>

        <% if (user.role === 'company' && user._id.toString() === listing.company._id.toString()) { %>
          <div style="display: flex; flex-direction: column; gap: 12px; border-top: 1px solid #e2e8f0; pt-3; margin-top: 10px; padding-top: 15px;">
            <p style="text-align: center; font-size: 0.85rem; color: var(--secondary); margin-bottom: 5px;"><%= __('listings-view.manageListing') %></p>
            
            <a href="/listings/edit/<%= listing._id %>" class="btn-outline" style="text-align: center; color: var(--primary); border-color: var(--primary); text-decoration: none; font-weight: 600; padding: 0.5rem; border-radius: 6px; border: 1px solid var(--primary);">
              <%= __('listings-view.editListing') %>
            </a>

            <form action="/listings/delete/<%= listing._id %>" method="POST" onsubmit="return confirm('<%= __('listings-view.deleteConfirm') %>');" style="text-align: center; margin-top: 5px;">
              <button type="submit" style="background: none; border: none; color: #e53e3e; cursor: pointer; font-weight: 600; font-size: 0.9rem; padding: 5px;">
                <%= __('listings-view.deleteListing') %>
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
