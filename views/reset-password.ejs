<div class="auth-card">
  <h2><%= __('resetPassword.title') %></h2>

  <% if(success_msg != '') { %>
    <div class="alert alert-success"><%= success_msg %></div>
  <% } %>
  
  <% if(error_msg != '') { %>
    <div class="alert alert-danger"><%= error_msg %></div>
  <% } %>

  <p
    style="
      text-align: center;
      color: var(--secondary);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    "
  >
    <%= __('resetPassword.instructions') %>
  </p>

  <form method="POST">
    <div class="form-group" style="position: relative">
      <label><%= __('resetPassword.newPasswordLabel') %></label>
      <input
        type="password"
        name="password"
        id="password"
        class="form-control"
        required
      />
      <i
        class="fas fa-eye toggle-password"
        onclick="togglePass('password')"
      ></i>
      <div id="password-strength-wrapper">
        <div id="strength-bar"></div>
        <small id="strength-text"></small>
      </div>
    </div>

    <div class="form-group" style="position: relative">
      <label><%= __('resetPassword.confirmNewPasswordLabel') %></label>
      <input
        type="password"
        id="confirmPassword"
        class="form-control"
        required
      />
      <i
        class="fas fa-eye toggle-password"
        onclick="togglePass('confirmPassword')"
      ></i>
      <small id="match-text" style="display: block; margin-top: 5px"></small>
    </div>

    <button type="submit" class="btn"><%= __('resetPassword.changePasswordBtn') %></button>
  </form>
</div>

<script src="/js/passwordCheck.js"></script>
